.vscode/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# 日志
logs/
*.log

# 临时文件
*.tmp
*.temp
.cache/
~$*
docs/~$*

# 本地 AI 辅助规划文件（不随仓库发布）
.zcode/

