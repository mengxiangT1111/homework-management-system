# 服务端口
PORT=3000

# 数据库配置（与 docker-compose.yml 对应）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=homework_db
DB_USER=homework
DB_PASSWORD=ChangeMe_Production_Password_Here
JWT_SECRET=ChangeMe_Random_JWT_Secret_Here
JWT_EXPIRES_IN=7d

# 文件上传目录
UPLOAD_DIR=uploads

# 文件清理：作业截止后保留天数
FILE_RETAIN_DAYS=30

# ===== 运行日志（文件落盘 + 自动轮转清理，防止堆满磁盘） =====
# 目录（默认 server/logs）；LOG_FILE_ENABLED=0 可关闭文件落盘（仅控制台）
#LOG_DIR=logs
#LOG_FILE_ENABLED=1
# 单个日志文件超过此大小（MB）轮转新文件
#LOG_MAX_FILE_MB=20
# 日志文件保留天数（超期自动删除）
#LOG_RETENTION_DAYS=14
# logs 目录总大小上限（MB，超限从最旧开始删）
#LOG_MAX_MB=200

# ===== 操作审计日志（数据库存储，自动清理） =====
# 审计记录保留天数（每天自动清理超期记录）
#OPLOG_RETENTION_DAYS=180
# 审计记录行数上限（超出从最旧开始删，防刷接口把表撑爆）
#OPLOG_MAX_ROWS=200000
