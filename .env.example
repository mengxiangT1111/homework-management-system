# 生产环境配置 - 复制此文件并修改敏感值
# MySQL root 密码（首次部署时设置，之后不要改）
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2024

# 业务数据库配置
DB_NAME=homework_db
DB_USER=homework
DB_PASSWORD=ChangeMe_Db_2024

# JWT 密钥（务必修改为随机字符串，可用 openssl rand -hex 32 生成）
JWT_SECRET=ChangeMe_Your_Random_Secret_Key_Here_2024

# 管理员初始账号（seed.prod.js 首次初始化时使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin_Pwd_2024

# ===== 可选：AI 批改（不填则 AI 批改功能不可用） =====
# AI_API_URL=https://api.example.com/v1/chat/completions
# AI_API_KEY=sk-xxxx
# AI_MODEL=gpt-4o

# ===== 可选：AI 批改升级（均有默认值，一般无需配置） =====
# AI_MODEL_FALLBACK=gpt-4o-mini        # 备用模型（主模型连续失败熔断时降级），留空禁用
# AI_TIMEOUT=60000                     # 单次LLM请求超时(ms)；推理模型(如glm-4.5-air)含思考单次批改约40s+，建议120000
# AI_MAX_RETRIES=2                     # 单模型网络层重试次数
# GRADING_CONCURRENCY=3                # 批改队列并发数
# GRADING_POLL_INTERVAL=2000           # 队列轮询间隔(ms)
# GRADING_MAX_ATTEMPTS=3               # 批改任务最大尝试次数
# GRADING_REVIEW_THRESHOLD=0.6         # 置信度低于此值进人工复核
# GRADING_AUTO_APPLY=1                 # 高置信结果自动回写分数(1/0)
# GRADING_DUAL_GRADE=0                 # A2 自一致性双评：同题二次批改(温度采样)分差过大转人工复核；默认关(开启后 LLM 调用翻倍)
# GRADING_DUAL_TAU=0.05                # 双评分差阈值（按满分归一化，0.05=满分的5%）
# GRADING_DUAL_TEMPERATURE=0.7         # 双评第二次调用的采样温度
# GRADING_PLAGIARISM_REVIEW_THRESHOLD=50  # L1 查重×批改联动：查重最高相似度≥此值(%)的提交，AI批改强制转人工复核；0=关闭

# ===== 可选：文档在线预览转换（doc/xls/ppt/pptx → PDF，需安装 LibreOffice） =====
# Docker 镜像已内置，无需配置；裸机部署装好 LibreOffice（soffice 在 PATH）即可，
# 装在非标准位置时指定 soffice 可执行文件完整路径
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# ===== 可选：腾讯云 COS（不填则作业文件存服务器本地数据卷） =====
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-beijing

# ===== 可选：查重检测服务（已随 docker compose 编排为 hw_detection 容器） =====
# 服务地址默认走容器内网 http://detection:8000，无需配置；
# 仅当检测服务部署在 compose 之外时才需覆盖（如宿主机独立部署 http://192.168.1.10:8000）
# DETECTION_SERVICE_URL=
# 服务间鉴权 token（配置后查重功能启用）：backend 与 detection 两个容器自动共用此值，
# 生成方式：openssl rand -hex 32。留空则查重功能禁用（其余功能不受影响）。
# DETECTION_API_TOKEN=
